# Copy file này thành ".env" và điền giá trị thật.
# KHÔNG commit file ".env" thật vào git.

# --- Telegram ---
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALLOWED_GROUP_ID=-1001234567890

# --- Wyse -> NMS ---
NMS_HOST=10.0.0.10
NMS_USER=wyse_bot
NMS_SSH_PORT=22
# Để trống nếu dùng key mặc định (~/.ssh/id_rsa hoặc ~/.ssh/id_ed25519) của user chạy bot trên Wyse
NMS_SSH_KEY_PATH=
SSH_TIMEOUT=15

# --- NMS -> Device ---
# Đường dẫn tới file SSH config có sẵn trên NMS (chứa Host alias cho từng thiết bị)
SSH_CONFIG_DEVICES_PATH=~/.ssh/config.devices

# Nếu private key dùng để NMS SSH xuống thiết bị có passphrase: BẮT BUỘC
# phải có ssh-agent đã unlock sẵn trên NMS (xem README), và điền lệnh source
# agent đó vào đây để bot nạp lại trước khi gọi ssh. Ví dụ dùng `keychain`:
#   NMS_REMOTE_ENV_SOURCE=source ~/.keychain/$(hostname)-sh
# Để trống nếu key không có passphrase.
NMS_REMOTE_ENV_SOURCE=

# --- NMS -> Device (thiết bị KHÔNG có SSH key, xác thực bằng password) ---
# Thư mục trên NMS chứa file password DÙNG CHUNG THEO VENDOR (tên file =
# tên vendor đã chuẩn hoá, ví dụ "juniper", "cisco" — không phải theo từng
# hostname). Mỗi vendor chỉ cần 1 password dùng chung cho mọi thiết bị
# password-auth cùng vendor. File do admin NMS tự tạo/quản lý, Bot KHÔNG
# đọc/lưu nội dung, chỉ tham chiếu đường dẫn cho `sshpass -f` chạy trên
# NMS. Bắt buộc nếu Devices.csv có thiết bị với key_type thuộc
# PASSWORD_KEY_TYPES.
DEVICE_PASSWORD_SECRETS_DIR=~/.ssh/device_secrets

# Đường dẫn/tên lệnh sshpass trên NMS (mặc định dùng PATH).
SSHPASS_BIN=sshpass

# Các giá trị của cột key_type trong Devices.csv được coi là "thiết bị
# không có SSH key, xác thực bằng password" (phân tách bằng dấu phẩy).
PASSWORD_KEY_TYPES=non,none,password

# --- Dữ liệu ---
DEVICES_CSV_PATH=./data/Devices.csv

# --- Logging ---
LOG_FILE_PATH=./logs/bot.log
LOG_LEVEL=INFO
